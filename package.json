    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
